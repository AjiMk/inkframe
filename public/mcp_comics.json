                "x": 3,
                "y": 2,
                "w": 94,
                "tail": "none"
              },
              {
                "id": "d-b18",
                "text": "Not a single window glowing. Absolute silence.",
                "kind": "caption",
                "x": 4,
                "y": 30,
                "w": 52,
                "tail": "none"
              },
              {
                "id": "d-b19",
                "text": "I can't see the street... I can't see my hands...",
                "kind": "thought",
                "x": 8,
                "y": 78,
                "w": 48,
                "tail": "bl"
              }
            ]
          }
        ]
      },
