            "image": "url:/demo/p3.jpg",
            "filter": "none",
            "bubbles": [
              {
                "id": "d-b7",
                "text": "Drip. Drip. Drip. She slows. The drip is regular. Something sits under it.",
                "kind": "title-banner",
                "x": 3,
                "y": 2,
                "w": 94,
                "tail": "none"
              },
              {
                "id": "d-b8",
                "text": "Pipe overhead. Water on concrete.",
                "kind": "caption",
                "x": 2.380636480270363,
                "y": 8.091032608695652,
                "w": 62,
                "tail": "none"
              },
              {
                "id": "d-b9",
                "text": "Just a leak. Keep walking.",
                "kind": "thought",
                "x": 35.52996213662108,
                "y": 28.07308135704875,
                "w": 64,
                "tail": "bl"
              }
            ]
          }
        ]
      },
      {
