      {
        "id": "d-p2",
        "layout": "splash",
        "panels": [
          {
            "id": "d-p2a",
            "image": "url:/demo/p2.jpg",
            "filter": "none",
            "bubbles": [
              {
                "id": "d-b4",
                "text": "Four blocks to the station. Every sharp click of my heels echoes off the darkened storefronts.",
                "kind": "title-banner",
                "x": 3,
                "y": 2,
                "w": 94,
                "tail": "none"
              },
              {
                "id": "d-b5",
                "text": "Traffic signals cycle green for streets abandoned for hours.",
                "kind": "caption",
                "x": 4,
                "y": 30,
                "w": 62,
                "tail": "none"
              },
              {
                "id": "d-b6",
                "text": "It’s too quiet tonight. Don’t look back.",
                "kind": "thought",
                "x": 8,
                "y": 78,
                "w": 64,
                "tail": "bl"
              }
            ]
          }
        ]
      },
      {
        "id": "d-p3",
        "layout": "splash",
        "panels": [
          {
            "id": "d-p3a",
            "image": "url:/demo/p3.jpg",
            "filter": "none",
            "bubbles": [
              {
                "id": "d-b7",
                "text": "Drip... drip... drip. A heavy, rhythmic tapping cuts through the freezing fog.",
                "kind": "title-banner",
                "x": 3,
                "y": 2,
                "w": 94,
                "tail": "none"
              },
              {
                "id": "d-b8",
                "text": "Subway steam vents hiss softly into the empty street.",
                "kind": "caption",
                "x": 4,
                "y": 30,
                "w": 62,
                "tail": "none"
              },
              {
                "id": "d-b9",
                "text": "Just condensation from a pipe. Keep moving.",
                "kind": "thought",
                "x": 8,
                "y": 78,
                "w": 64,
                "tail": "bl"
              }
            ]
          }
        ]
      },
      {
        "id": "d-p4",
        "layout": "splash",
        "panels": [
          {
            "id": "d-p4a",
            "image": "url:/demo/p4.jpg",
            "filter": "none",
            "bubbles": [
              {
                "id": "d-b10",
                "text": "Curiosity overrides caution as a faint voice turns down the narrow alleyway.",
                "kind": "title-banner",
                "x": 3,
                "y": 2,
                "w": 94,
                "tail": "none"
              },
              {
                "id": "d-b10b",
                "text": "…Mommy…?",
                "kind": "shout",
                "x": 54,
                "y": 34,
                "w": 40,
                "tail": "none"
              },
              {
                "id": "d-b11",
                "text": "High, fragile... a child's cry, impossibly close.",
                "kind": "caption",
                "x": 4,
                "y": 22,
                "w": 48,
                "tail": "none"
              },
              {
                "id": "d-b12",
                "text": "A kid? Out here at midnight?",
                "kind": "thought",
                "x": 6,
                "y": 64,
                "w": 46,
                "tail": "bl"
              },
              {
                "id": "d-b13",
                "text": "I can't ignore them. Hello?!",
                "kind": "thought",
                "x": 28,
                "y": 80,
                "w": 64,
                "tail": "br"
              }
            ]
          }
        ]
      },
      {
        "id": "d-p5",
        "layout": "splash",
        "panels": [
          {
            "id": "d-p5a",
            "image": "url:/demo/p5.jpg",
            "filter": "none",
            "bubbles": [
              {
                "id": "d-b14",
                "text": "The alley is a dead end. No child... only a waterlogged porcelain doll.",
                "kind": "title-banner",
                "x": 3,
                "y": 2,
                "w": 94,
                "tail": "none"
              },
              {
                "id": "d-b15",
                "text": "The weeping stops dead the instant my shadow touches it.",
                "kind": "caption",
                "x": 4,
                "y": 28,
                "w": 62,
                "tail": "none"
              },
              {
                "id": "d-b16",
                "text": "No footprints... no shadow. Where did the voice come from?",
                "kind": "thought",
                "x": 8,
                "y": 78,
                "w": 68,
                "tail": "bl"
              }
            ]
          }
        ]
      },
      {
