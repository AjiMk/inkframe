            "image": "url:/demo/p4.jpg",
            "filter": "none",
            "bubbles": [
              {
                "id": "d-b10",
                "text": "She leaves the subway path and follows the sound into the side street.",
                "kind": "title-banner",
                "x": 3,
                "y": 2,
                "w": 94,
                "tail": "none"
              },
              {
                "id": "d-b10b",
                "text": "…Mommy…",
                "kind": "shout",
                "x": 60,
                "y": 43.390954380764164,
                "w": 40,
                "tail": "none"
              },
              {
                "id": "d-b11",
                "text": "Thin. Close. Not on the street. She runs.",
                "kind": "caption",
                "x": 52,
                "y": 6.303977272727274,
                "w": 48,
                "tail": "none"
              },
              {
                "id": "d-b12",
                "text": "A kid? Out here?",
                "kind": "thought",
                "x": 1.8694495728635356,
                "y": 7.710371376811597,
                "w": 46,
                "tail": "bl"
              },
              {
                "id": "d-b13",
                "text": "Don’t think. Find them.",
                "kind": "thought",
                "x": 2.950840191507338,
                "y": 14.071352108036894,
                "w": 64,
                "tail": "bl"
              }
            ]
          }
        ]
      },
