                "x": 3,
                "y": 2,
                "w": 94,
                "tail": "none"
              },
              {
                "id": "d-b2",
                "text": "Lobby dark. Door locks behind her.",
                "kind": "caption",
                "x": 4,
                "y": 30,
                "w": 58,
                "tail": "none"
              },
              {
                "id": "d-b3",
                "text": "Bag. Keys. Subway. Home.",
