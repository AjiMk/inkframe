                "x": 3,
                "y": 2,
                "w": 94,
                "tail": "none"
              },
              {
                "id": "d-b15",
                "text": "Cry stops the moment she sees it.",
                "kind": "caption",
                "x": 2.7412773414275433,
                "y": 8.100255270092227,
                "w": 62,
                "tail": "none"
              },
              {
                "id": "d-b16",
                "text": "Where are you? Who left this?",
