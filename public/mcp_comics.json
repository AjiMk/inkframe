            "image": "url:/neighbour-aunty/cover.jpg",
            "filter": "anime-cel",
            "bubbles": [
              {
                "id": "2135f972-0efc-4397-a18d-285e8387e257",
                "text": "Next door. Every evening. Same red saree.",
                "kind": "caption",
                "x": 4,
                "y": 4,
                "w": 92,
                "tail": "none"
              },
              {
                "id": "41f61177-fe7f-48a8-bda9-896040a6315c",
                "text": "Come in. Don't just stand there.",
                "kind": "speech",
                "x": 52,
                "y": 58,
                "w": 42,
                "tail": "bl"
              }
            ]
          }
        ]
      }
    ],
