            "bubbles": [
              {
                "id": "d-b1",
                "text": "11:47 PM. Forty stories of glass and steel fall dead silent. The last shift ends.",
                "kind": "title-banner",
                "x": 3,
                "y": 2,
                "w": 94,
                "tail": "none"
              },
              {
                "id": "d-b2",
                "text": "The heavy glass lobby doors lock automatically behind me.",
                "kind": "caption",
                "x": 4,
                "y": 30,
                "w": 58,
                "tail": "none"
              },
              {
                "id": "d-b3",
                "text": "Keys. Phone. Purse. Just make it to the train...",
                "kind": "thought",
                "x": 8,
                "y": 78,
                "w": 62,
                "tail": "bl"
              }
            ]
          }
        ]
