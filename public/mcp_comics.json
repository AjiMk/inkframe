            "image": "url:/demo/p2.jpg",
            "filter": "none",
            "bubbles": [
              {
                "id": "d-b4",
                "text": "Four blocks. No one. Her heels are the only sound between her and the station.",
                "kind": "title-banner",
                "x": 3,
                "y": 2,
                "w": 94,
                "tail": "none"
              },
              {
                "id": "d-b5",
                "text": "Shops shut. Signals green for nothing.",
                "kind": "caption",
                "x": 3.3014050129862,
                "y": 19.43202404479578,
                "w": 62,
                "tail": "none"
              },
              {
                "id": "d-b6",
                "text": "Too quiet. Don’t look back.",
                "kind": "thought",
                "x": 33.75323090402728,
                "y": 33.147603754940704,
                "w": 64,
                "tail": "bl"
              }
            ]
          }
        ]
      },
      {
